<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>eu.ralph-schuster</groupId>
		<artifactId>pom-oss</artifactId>
		<version>21.3.0</version>
	</parent>

	<properties>
		<project.home>https://github.com/technicalguru/rslibs</project.home>
		<maven.bundle.version>5.1.8</maven.bundle.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<log4j.version>2.26.1</log4j.version>
		<slf4j.version>2.0.18</slf4j.version>
	</properties>

	<artifactId>libs</artifactId>
	<version>6.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<url>https://github.com/technicalguru/rslibs</url>
	<name>eu.ralph-schuster.libs</name>
	<description>A collection of utilities</description>

	<scm>
		<connection>scm:git:https://github.com/technicalguru/rslibs.git</connection>
		<developerConnection>scm:git:https://github.com/technicalguru/rslibs.git</developerConnection>
		<url>https://github.com/technicalguru/rslibs</url>
		<tag>v6.1.0</tag>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/technicalguru/rslibs/issues</url>
	</issueManagement>

	<developers>
		<developer>
			<id>ralph</id>
			<name>Ralph Schuster</name>
		</developer>
	</developers>

	<modules>
		<module>baselib</module>
		<module>templating</module>
		<module>jackson2</module>
		<module>jackson</module>
		<module>otp</module>
		<module>csv</module>
		<module>jersey-client</module>
		<module>rest-client</module>
		<module>mail-queue</module>
		<module>mail-templates</module>
	</modules>
	
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hamcrest</groupId>
			<artifactId>hamcrest-library</artifactId>
			<version>3.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.21.0</version>
                <configuration>
                    <!-- No Beta-/Alpha-Versions -->
                    <allowSnapshots>false</allowSnapshots>
                    <ignoredVersions>
                    	<ignoredVersion>.*-M.*</ignoredVersion>
                    	<ignoredVersion>.*-alpha.*</ignoredVersion>
                    	<ignoredVersion>.*-beta.*</ignoredVersion>
                    </ignoredVersions>
                </configuration>
                <executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>display-dependency-updates</goal>
						</goals>
					</execution>
				</executions>
            </plugin>
		</plugins>
	</build>
</project>
